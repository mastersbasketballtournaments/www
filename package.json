{
  "name": "webroot",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "rm -rf ./_site && run-p dev:eleventy dev:css",
    "dev:eleventy": "npx @11ty/eleventy --input ./src/ --serve",
    "dev:css": "npx @tailwindcss/cli -i ./src/_styles/app.css -o ./_site/assets/css/app.css --watch=always",
    "build": "rm -rf ./_site && npx @11ty/eleventy --input ./src/ && npx @tailwindcss/cli -i ./src/_styles/app.css -o ./_site/assets/css/app.css --minify"
  },
