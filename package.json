  "devDependencies": {
    "@tailwindcss/cli": "^4.3.2",
    "dotenv": "^16.5.0",
    "npm-run-all2": "^8.0.4",
    "tailwindcss": "^4.3.2"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@11ty/eleventy-fetch": "^5.1.1",
